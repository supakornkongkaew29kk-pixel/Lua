-- สร้างหน้าต่าง GUI
local ScreenGui = Instance.new("ScreenGui")
local Frame = Instance.new("Frame")
local Title = Instance.new("TextLabel")

local SpeedBtn = Instance.new("TextButton")
local JumpBtn = Instance.new("TextButton")
local EspBtn = Instance.new("TextButton")
local InvisBtn = Instance.new("TextButton")
local FlyBtn = Instance.new("TextButton")
local NoclipBtn = Instance.new("TextButton")

-- ตั้งค่า ScreenGui
ScreenGui.Name = "AdvancedCheatMenu"
ScreenGui.Parent = game.CoreGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- ตั้งค่ากรอบเมนูหลัก (ปรับขนาดให้ใหญ่ขึ้นเพื่อให้ใส่ปุ่มหมด)
Frame.Parent = ScreenGui
Frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
Frame.Position = UDim2.new(0.05, 0, 0.15, 0)
Frame.Size = UDim2.new(0, 220, 0, 380)
Frame.Active = true
Frame.Draggable = true -- ทำให้ลากเลื่อนหน้าต่างได้

-- หัวข้อเมนู
Title.Parent = Frame
Title.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
Title.Size = UDim2.new(0, 220, 0, 40)
Title.Font = Enum.Font.SourceSansBold
Title.Text = "Roblox Ultimate Menu"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 18

-- 1. ปุ่มวิ่งเร็ว (Speed 100)
SpeedBtn.Parent = Frame
SpeedBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
SpeedBtn.Position = UDim2.new(0.1, 0, 0.13, 0)
SpeedBtn.Size = UDim2.new(0, 180, 0, 35)
SpeedBtn.Font = Enum.Font.SourceSansBold
SpeedBtn.Text = "วิ่งเร็ว (Speed: 100)"
SpeedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedBtn.TextSize = 14
SpeedBtn.MouseButton1Click:Connect(function()
    local player = game.Players.LocalPlayer
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.WalkSpeed = 100
    end
end)

-- 2. ปุ่มกระโดดสูง
JumpBtn.Parent = Frame
JumpBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
JumpBtn.Position = UDim2.new(0.1, 0, 0.25, 0)
JumpBtn.Size = UDim2.new(0, 180, 0, 35)
JumpBtn.Font = Enum.Font.SourceSansBold
JumpBtn.Text = "กระโดดสูง"
JumpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
JumpBtn.TextSize = 14
JumpBtn.MouseButton1Click:Connect(function()
    local player = game.Players.LocalPlayer
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.UseJumpPower = true
        player.Character.Humanoid.JumpPower = 100
    end
end)

-- 3. ปุ่มมองทะลุกำแพง (ESP)
EspBtn.Parent = Frame
EspBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
EspBtn.Position = UDim2.new(0.1, 0, 0.37, 0)
EspBtn.Size = UDim2.new(0, 180, 0, 35)
EspBtn.Font = Enum.Font.SourceSansBold
EspBtn.Text = "มองทะลุกำแพง (ESP)"
EspBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
EspBtn.TextSize = 14
EspBtn.MouseButton1Click:Connect(function()
    for _, p in pairs(game.Players:GetPlayers()) do
        if p ~= game.Players.LocalPlayer and p.Character then
            if not p.Character:FindFirstChildOfClass("Highlight") then
                local highlight = Instance.new("Highlight")
                highlight.Parent = p.Character
                highlight.FillColor = Color3.fromRGB(255, 0, 0)
            end
        end
    end
end)

-- 4. ปุ่มหายตัว
InvisBtn.Parent = Frame
InvisBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
InvisBtn.Position = UDim2.new(0.1, 0, 0.49, 0)
InvisBtn.Size = UDim2.new(0, 180, 0, 35)
InvisBtn.Font = Enum.Font.SourceSansBold
InvisBtn.Text = "หายตัว"
InvisBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
InvisBtn.TextSize = 14
InvisBtn.MouseButton1Click:Connect(function()
    local player = game.Players.LocalPlayer
    if player.Character then
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("MeshPart") then
                part.Transparency = 1
            elseif part:IsA("Accessory") then
                local handle = part:FindFirstChild("Handle")
                if handle then handle.Transparency = 1 end
            end
        end
    end
end)

-- 5. ปุ่มบิน (Fly)
FlyBtn.Parent = Frame
FlyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
FlyBtn.Position = UDim2.new(0.1, 0, 0.61, 0)
FlyBtn.Size = UDim2.new(0, 180, 0, 35)
FlyBtn.Font = Enum.Font.SourceSansBold
FlyBtn.Text = "บิน (Fly)"
FlyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
FlyBtn.TextSize = 14
FlyBtn.MouseButton1Click:Connect(function()
    loadstring(game:HttpGet("https://pastebin.com/raw/1pX13Z8G"))() -- โค้ดบินมาตรฐาน
end)

-- 6. ปุ่มเดินทะลุกำแพง (Noclip)
NoclipBtn.Parent = Frame
NoclipBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
NoclipBtn.Position = UDim2.new(0.1, 0, 0.73, 0)
NoclipBtn.Size = UDim2.new(0, 180, 0, 35)
NoclipBtn.Font = Enum.Font.SourceSansBold
NoclipBtn.Text = "เดินทะลุกำแพง (Noclip)"
NoclipBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
NoclipBtn.TextSize = 14
local noclipEnabled = false
NoclipBtn.MouseButton1Click:Connect(function()
    noclipEnabled = not noclipEnabled
    local player = game.Players.LocalPlayer
    game:GetService("RunService").Stepped:Connect(function()
        if noclipEnabled and player.Character then
            for _, part in pairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
    if noclipEnabled then
        NoclipBtn.Text = "ปิดทะลุกำแพง (Noclip)"
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    else
        NoclipBtn.Text = "เดินทะลุกำแพง (Noclip)"
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)

